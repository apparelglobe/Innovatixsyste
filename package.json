{
  "name": "innovatix-os",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "npm@10.8.2",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "npm run test -w apps/api",
    "test:unit": "npm run test:unit -w apps/api",
    "test:integration": "npm run test:integration -w apps/api",
    "test:e2e": "npm run test:e2e -w apps/api",
    "test:db:prepare": "npm run test:db:prepare -w apps/api",
    "test:db:reset": "npm run test:db:reset -w apps/api",
    "db:backup": "bash scripts/backup-db.sh",
    "db:restore": "bash scripts/restore-db.sh",
    "verify:prod-config": "bash scripts/verify-prod-config.sh",
    "smoke": "bash scripts/smoke-test.sh"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.4.5"
  }
}
