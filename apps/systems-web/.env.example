# ─────────────────────────────────────────────────────────────────────────────
# Canonical hostname — single source of truth (read ONLY by src/lib/site.ts).
# Drives canonicals, sitemap, robots, Open Graph, Twitter, structured data,
# form-confirmation links, and booking links. No file may hardcode the host.
#
# Primary var: NEXT_PUBLIC_SITE_URL (must be exposed to the client bundle).
# SITE_URL is accepted as a server-only fallback alias for backward compat.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://innovatixmarketing.com

# Production enforcement. In CI / Vercel this is implicit. For a manual
# production build outside CI, set this to 1 so the build FAILS if the URL is
# missing, malformed, non-https, or localhost:
# INNOVATIX_ENFORCE_SITE_URL=1

# Backend API base (lead pipeline). Client-exposed.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4040/v1

# Cal.com booking page for the /book scheduling embed.
NEXT_PUBLIC_CALCOM_URL=https://cal.com/innovatix/consultation

# GA4 (optional). When unset, analytics events still push to dataLayer (GTM-ready) but no GA script loads.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
