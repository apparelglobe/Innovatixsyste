// Innovatix lead-pipeline schema.
//
// Design rules (Step 3 spec):
//  • Multi-tenant-ready: every business record carries tenantId; compound indexes
//    lead with tenantId; schema can adopt PostgreSQL RLS later without redesign.
//  • Dedup identity = (tenantId, normalizedEmail) UNIQUE. Repeated submissions are
//    preserved as separate LeadInquiry rows — never discarded, never silently merged.
//  • Durable side effects: Lead/Inquiry/Attribution/Audit + pending SideEffectJob
//    all commit in ONE transaction; a worker drains jobs with retry/backoff/DLQ.
//  • Privacy: no raw IP stored — only a salted hash with an expiry. Sensitive fields
//    are never logged.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Tenancy ──────────────────────────────────────────────────────────────────
model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads         Lead[]
  inquiries     LeadInquiry[]
  attributions  LeadAttribution[]
  activities    LeadActivity[]
  auditEvents   AuditEvent[]
  jobs          SideEffectJob[]
  emails        EmailOutbox[]
  assignments   Assignment[]
  slaTimers     SlaTimer[]
  meetings      Meeting[]
  rateLimits    RateLimitCounter[]

  @@map("tenants")
}

// ── Lead: the person/company sales record (one per tenant+email) ─────────────
model Lead {
  id              String     @id @default(cuid())
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id])

  email           String     // original, as submitted
  normalizedEmail String     // lowercased + trimmed — dedup identity
  firstName       String?
  lastName        String?
  company         String?    // original value preserved
  companyNormalized String?  // normalized for comparison only
  phone           String?
  jobTitle        String?

  status          LeadStatus @default(NEW)
  estimatedValueCents Int?     // pipeline value, set when a proposal is drafted

  firstTouchAttributionId String? @unique
  firstTouchAttribution   LeadAttribution? @relation("FirstTouch", fields: [firstTouchAttributionId], references: [id])
  lastTouchAttributionId  String? @unique
  lastTouchAttribution    LeadAttribution? @relation("LastTouch", fields: [lastTouchAttributionId], references: [id])

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  inquiries   LeadInquiry[]
  activities  LeadActivity[]
  jobs        SideEffectJob[]
  emails      EmailOutbox[]
  assignment  Assignment?
  slaTimers   SlaTimer[]
  meetings    Meeting[]
  proposals   Proposal[]

  @@unique([tenantId, normalizedEmail]) // concurrency-safe dedup identity
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, companyNormalized])
  @@map("leads")
}

// ── LeadInquiry: every submission preserved (history), even when merged ──────
model LeadInquiry {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  leadId          String
  lead            Lead     @relation(fields: [leadId], references: [id])

  form            InquiryForm
  serviceInterest String?
  serviceId       String?   // resolved catalog Service, when known
  projectDescription String?
  budgetRange     String?
  desiredStartWindow String?
  landingPage     String?

  consentStatus   ConsentStatus @default(NOT_REQUIRED)
  consentAt       DateTime?
  consentPolicyVersion String?

  spamResult      SpamResult @default(CLEAN)
  spamScore       Int        @default(0)
  spamReasons     String[]   @default([])

  // sanitized snapshot of the submitted fields (never the raw IP/UA)
  sanitizedPayload Json

  idempotencyKey  String

  attribution     LeadAttribution? @relation("InquiryAttribution")

  submittedAt     DateTime @default(now())

  @@unique([tenantId, idempotencyKey]) // double-click / retry protection
  @@index([tenantId, leadId])
  @@index([tenantId, submittedAt])
  @@index([tenantId, serviceId])
  @@map("lead_inquiries")
}

// ── LeadAttribution: first/last touch + UTM + GCLID snapshot ─────────────────
model LeadAttribution {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  inquiryId     String?  @unique
  inquiry       LeadInquiry? @relation("InquiryAttribution", fields: [inquiryId], references: [id])

  landingPage   String?
  referrerUrl   String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmTerm       String?
  utmContent    String?
  gclid         String?
  userAgent     String?   // stored on attribution row (not in logs)

  createdAt     DateTime @default(now())

  firstTouchOf  Lead?    @relation("FirstTouch")
  lastTouchOf   Lead?    @relation("LastTouch")

  @@index([tenantId, createdAt])
  @@map("lead_attributions")
}

// ── LeadActivity: timeline (status change, assignment, meeting, email) ───────
model LeadActivity {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])

  type      ActivityType
  data      Json?
  createdAt DateTime @default(now())

  @@index([tenantId, leadId])
  @@index([tenantId, createdAt])
  @@map("lead_activities")
}

// ── AuditEvent: append-only audit trail ──────────────────────────────────────
model AuditEvent {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  entityType    String
  entityId      String
  action        String
  actorType     ActorType @default(SYSTEM)
  actorId       String?
  data          Json?
  correlationId String?

  createdAt     DateTime @default(now())

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@index([correlationId])
  @@map("audit_events")
}

// ── SideEffectJob: durable outbox (retry/backoff/DLQ/idempotency) ────────────
model SideEffectJob {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  leadId        String?
  lead          Lead?     @relation(fields: [leadId], references: [id])
  inquiryId     String?

  type          JobType
  status        JobStatus @default(PENDING)
  payload       Json
  idempotencyKey String   @unique

  attempts      Int       @default(0)
  maxAttempts   Int       @default(6)
  nextAttemptAt DateTime  @default(now())
  lastError     String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([tenantId, leadId])
  @@map("side_effect_jobs")
}

// ── EmailOutbox: dev outbox + record of every transactional email ────────────
model EmailOutbox {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  leadId        String?
  lead          Lead?       @relation(fields: [leadId], references: [id])
  inquiryId     String?

  type          EmailType
  transport     String      // 'outbox' | 'postmark'
  toAddress     String
  fromAddress   String
  subject       String
  htmlBody      String
  textBody      String
  status        EmailStatus @default(QUEUED)
  providerMessageId String?
  error         String?

  createdAt     DateTime    @default(now())
  sentAt        DateTime?

  @@index([tenantId, createdAt])
  @@index([tenantId, type])
  @@map("email_outbox")
}

// ── Assignment: routing to the sales queue ───────────────────────────────────
model Assignment {
  id         String           @id @default(cuid())
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  leadId     String           @unique
  lead       Lead             @relation(fields: [leadId], references: [id])

  queue      String           @default("innovatix-systems-sales")
  assigneeId String?
  status     AssignmentStatus @default(UNASSIGNED)
  assignedAt DateTime?

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([tenantId, status])
  @@map("assignments")
}

// ── SlaTimer: business-hours-aware first-response timer ──────────────────────
model SlaTimer {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  leadId       String
  lead         Lead      @relation(fields: [leadId], references: [id])

  targetMinutes Int
  startedAt    DateTime  @default(now())
  dueAt        DateTime
  satisfiedAt  DateTime?
  status       SlaStatus @default(ACTIVE)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, dueAt])
  @@index([tenantId, status])
  @@map("sla_timers")
}

// ── Meeting: Cal.com booking linked to a lead ────────────────────────────────
model Meeting {
  id               String        @id @default(cuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id])
  leadId           String
  lead             Lead          @relation(fields: [leadId], references: [id])

  provider         String        @default("calcom")
  providerBookingId String
  status           MeetingStatus @default(SCHEDULED)
  scheduledAt      DateTime?
  endsAt           DateTime?
  attendeeEmail    String?
  meetingUrl       String?
  rawPayload       Json?

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([provider, providerBookingId])
  @@index([tenantId, leadId])
  @@map("meetings")
}

// ── RateLimitCounter: DB-backed, hashed-identifier sliding window ────────────
model RateLimitCounter {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  hashedId   String   // salted hash of the abuse identifier — never the raw IP
  windowStart DateTime
  count      Int      @default(0)
  expiresAt  DateTime // retention: rows past this are purgeable

  @@unique([tenantId, hashedId, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_counters")
}

// ── Client Portal (Launch 2) ─────────────────────────────────────────────────
// Portal models carry a scalar tenantId (indexed) for tenant-scoping without
// adding back-relations to Tenant; tenant integrity is enforced in the app and
// through the ClientOrg relation. Within-portal relations use real FKs.

model ClientOrg {
  id        String   @id @default(cuid())
  tenantId  String
  leadId    String?  // origin lead, when converted from the pipeline
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    ClientUser[]
  projects Project[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("client_orgs")
}

model ClientUser {
  id           String         @id @default(cuid())
  tenantId     String
  clientOrgId  String
  clientOrg    ClientOrg      @relation(fields: [clientOrgId], references: [id])
  email        String
  normalizedEmail String
  passwordHash String
  firstName    String?
  lastName     String?
  role         ClientUserRole @default(MEMBER)
  active       Boolean        @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([tenantId, normalizedEmail])
  @@index([clientOrgId])
  @@map("client_users")
}

// Secure client-user onboarding. A staff member (or an org OWNER) issues an
// invitation; the recipient sets their own password via a one-time link. We NEVER
// generate, store, log, or email a temporary password. Only the SHA-256 hash of a
// 256-bit random token is persisted — the raw token exists only in the setup link.
// Single-use, expiring, and revocable; app-layer tenant isolation (bare-string FKs,
// consistent with the rest of the portal tables).
model ClientInvitation {
  id                   String         @id @default(cuid())
  tenantId             String
  clientOrgId          String
  leadId               String? // origin lead when the invite came from a conversion
  email                String
  normalizedEmail      String
  firstName            String?
  lastName             String?
  role                 ClientUserRole @default(MEMBER)

  // Only the hash is stored; the raw token is never persisted.
  tokenHash            String    @unique
  expiresAt            DateTime
  acceptedAt           DateTime?
  acceptedByUserId     String?
  revokedAt            DateTime?
  revokedReason        String?

  createdByStaffUserId String? // null when an org OWNER issues the invite (actor recorded in audit)
  lastSentAt           DateTime?
  sendCount            Int       @default(0)

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([tenantId, normalizedEmail])
  @@index([tenantId, clientOrgId])
  @@index([expiresAt])
  @@map("client_invitations")
}

model Project {
  id              String        @id @default(cuid())
  tenantId        String
  clientOrgId     String
  clientOrg       ClientOrg     @relation(fields: [clientOrgId], references: [id])
  leadId          String?
  name            String
  code            String?
  status          ProjectStatus @default(DISCOVERY)
  percentComplete Int           @default(0)
  startDate       DateTime?
  dueDate         DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  milestones Milestone[]
  reports    ProjectReport[]
  approvals  Approval[]
  files      ProjectFile[]
  invoices   Invoice[]
  messages   PortalMessage[]
  members    ProjectMember[]
  activities PortalActivity[]

  @@index([tenantId, clientOrgId])
  @@index([tenantId, status])
  @@map("projects")
}

model Milestone {
  id          String          @id @default(cuid())
  tenantId    String
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id])
  name        String
  sequence    Int             @default(0)
  status      MilestoneStatus @default(PLANNED)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())

  approvals Approval[]

  @@index([projectId, sequence])
  @@map("milestones")
}

model ProjectReport {
  id          String     @id @default(cuid())
  tenantId    String
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id])
  kind        ReportKind @default(WEEKLY)
  title       String
  summary     String
  periodStart DateTime?
  periodEnd   DateTime?
  publishedAt DateTime   @default(now())
  createdAt   DateTime   @default(now())

  @@index([projectId, publishedAt])
  @@map("project_reports")
}

model Approval {
  id           String         @id @default(cuid())
  tenantId     String
  projectId    String
  project      Project        @relation(fields: [projectId], references: [id])
  milestoneId  String?
  milestone    Milestone?     @relation(fields: [milestoneId], references: [id])
  type         ApprovalType   @default(MILESTONE)
  subject      String
  status       ApprovalStatus @default(PENDING)
  requestedByStaffId String?
  relatedType  String?        // 'Milestone' | 'ProjectFile' | 'Project' …
  relatedId    String?
  decidedByUserId String?
  decidedAt    DateTime?
  note         String?
  createdAt    DateTime       @default(now())

  @@index([tenantId, projectId])
  @@index([projectId, status])
  @@map("approvals")
}

model ProjectFile {
  id         String       @id @default(cuid())
  tenantId   String
  projectId  String
  project    Project      @relation(fields: [projectId], references: [id])
  name       String
  category   FileCategory @default(DELIVERABLE)
  sizeBytes  Int?
  mimeType   String?
  storageProvider String?  // 'local' | 's3'
  storageKey String?       // object-storage key
  version    Int          @default(1)
  rootId     String?      // first version's id (self for v1) — groups a version chain
  isCurrent  Boolean      @default(true) // only the latest non-deleted version is current
  // Full upload/scan lifecycle. A file is downloadable ONLY in AVAILABLE.
  state      FileState    @default(AVAILABLE)
  scanStatus String       @default("clean") // legacy: 'clean' | 'infected' | 'pending'
  fileHash   String?      // SHA-256 of the object (audit evidence + dedup later)
  scans      FileScan[]
  uploadedByStaffId String?
  clientVisible Boolean    @default(true)
  deletedAt  DateTime?
  uploadedAt DateTime     @default(now())

  @@index([projectId, category])
  @@index([tenantId, projectId])
  @@index([rootId])
  @@map("project_files")
}

model Invoice {
  id         String        @id @default(cuid())
  tenantId   String
  // projectId is optional: a DEPOSIT invoice is issued against an accepted proposal
  // BEFORE the project exists (paying it is what creates the project — Canon §5).
  projectId  String?
  project    Project?      @relation(fields: [projectId], references: [id])
  clientOrgId String?      // set for deposit invoices that precede a project
  proposalId String?
  proposal   Proposal?     @relation(fields: [proposalId], references: [id])
  kind       InvoiceKind   @default(STANDARD)
  number     String
  amountCents Int
  currency   String        @default("USD")
  status     InvoiceStatus @default(SENT)
  billingContactUserId String?
  paymentUrl String?
  pdfKey     String?
  issuedAt   DateTime?
  dueAt      DateTime?
  paidAt     DateTime?
  createdAt  DateTime      @default(now())

  lineItems  InvoiceLineItem[]
  payments   Payment[]

  @@index([tenantId, projectId])
  @@index([projectId, status])
  @@index([tenantId, clientOrgId])
  @@index([tenantId, proposalId])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  tenantId    String
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  description String
  quantity    Int      @default(1)
  unitCents   Int
  amountCents Int
  milestoneId String?
  servicePackageId String?  // snapshot reference to the catalog package (no FK)
  createdAt   DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_line_items")
}

// A single payment attempt/record for an invoice through a payment provider.
// Tenant- and org-scoped. Created PENDING when a checkout session is opened; the
// provider WEBHOOK (authoritative — never the success redirect) transitions it to
// PAID/FAILED/CANCELED. All provider identifiers are stored for reconciliation.
model Payment {
  id                 String        @id @default(cuid())
  tenantId           String
  clientOrgId        String? // null for a DEPOSIT payment — the org is created at activation (Canon §5)
  invoiceId          String
  invoice            Invoice       @relation(fields: [invoiceId], references: [id])

  provider           String // 'stub' | 'stripe'
  providerCustomerId String?
  checkoutSessionId  String?
  paymentIntentId    String?
  providerEventId    String? // the webhook event that last transitioned this payment

  amountCents        Int // authoritative amount, copied from the invoice server-side
  currency           String
  status             PaymentStatus @default(PENDING)
  paidAt             DateTime?
  failureReason      String?
  refundStatus       String?

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([tenantId, clientOrgId])
  @@index([invoiceId])
  @@index([checkoutSessionId])
  @@index([paymentIntentId])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  REFUNDED
}

// Idempotency / replay ledger for provider webhook events. A UNIQUE (provider,
// providerEventId) means a duplicate delivery is a fast no-op — the invoice can
// never be transitioned twice by the same event.
model ProcessedWebhookEvent {
  id              String   @id @default(cuid())
  provider        String
  providerEventId String
  type            String
  createdAt       DateTime @default(now())

  @@unique([provider, providerEventId])
  @@map("processed_webhook_events")
}

model PortalMessage {
  id           String            @id @default(cuid())
  tenantId     String
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id])
  authorType   MessageAuthorType
  authorUserId String?
  authorStaffId String?
  internal     Boolean           @default(false) // internal-only note, hidden from the client
  body         String
  readByClientAt DateTime?
  readByTeamAt DateTime?
  createdAt    DateTime          @default(now())

  @@index([tenantId, projectId])
  @@index([projectId, createdAt])
  @@map("portal_messages")
}

model ProjectMember {
  id            String   @id @default(cuid())
  tenantId      String
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  staffUserId   String?  // links to the assigned StaffUser (null = display-only)
  name          String
  role          String
  clientVisible Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([projectId])
  @@map("project_members")
}

// Client-facing project activity feed (report generated, milestone approved, file uploaded…).
model PortalActivity {
  id        String   @id @default(cuid())
  tenantId  String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  type      String
  message   String
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@map("portal_activities")
}

// ── Delivery side (staff) ────────────────────────────────────────────────────
model StaffUser {
  id           String    @id @default(cuid())
  tenantId     String
  email        String
  normalizedEmail String
  passwordHash String
  firstName    String?
  lastName     String?
  role         StaffRole @default(ENGINEER)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([tenantId, normalizedEmail])
  @@index([tenantId, role])
  @@map("staff_users")
}

// In-app notification (also mirrored to email via the outbox where relevant).
model Notification {
  id           String           @id @default(cuid())
  tenantId     String
  recipientType RecipientType   // CLIENT | STAFF
  recipientId  String           // clientUserId or staffUserId
  type         NotificationType
  title        String
  body         String?
  linkPath     String?
  projectId    String?
  read         Boolean          @default(false)
  readAt       DateTime?
  createdAt    DateTime         @default(now())

  @@index([tenantId, recipientType, recipientId, read])
  @@index([createdAt])
  @@map("notifications")
}

// ── Activation Gate (Phase 1): catalog → proposal → contract → deposit ───────
// Sales-side artifacts that live against a LEAD on a secure link BEFORE a client
// account exists. Per Canon §5, the client org / account / project are created
// ONLY after the activation deposit is paid. New tables follow the portal
// convention: scalar tenantId (indexed) for tenant-scoping; real FKs for
// within-feature links. Money is integer cents + currency, as elsewhere.

model Service {
  id            String          @id @default(cuid())
  tenantId      String
  slug          String
  name          String
  category      ServiceCategory @default(OTHER) // coarse bucket for code
  categorySlug  String?         // real category slug from the marketing site (e.g. "enterprise-systems")
  categoryLabel String?         // real category label (e.g. "Enterprise Systems")
  summary       String?
  active        Boolean         @default(true)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  packages  ServicePackage[]

  @@unique([tenantId, slug])
  @@index([tenantId, active])
  @@index([tenantId, categorySlug])
  @@map("services")
}

model ServicePackage {
  id         String   @id @default(cuid())
  tenantId   String
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id])
  name       String   // e.g. "Standard", "Pro"
  summary    String?
  priceCents Int?     // indicative/base price; null = quote-only
  currency   String   @default("USD")
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  deliverables  CatalogDeliverable[]
  proposalItems ProposalLineItem[]

  @@index([tenantId, serviceId])
  @@map("service_packages")
}

model CatalogDeliverable {
  id               String         @id @default(cuid())
  tenantId         String
  servicePackageId String
  servicePackage   ServicePackage @relation(fields: [servicePackageId], references: [id])
  label            String
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())

  @@index([tenantId, servicePackageId])
  @@map("catalog_deliverables")
}

model Proposal {
  id             String         @id @default(cuid())
  tenantId       String
  leadId         String
  lead           Lead           @relation(fields: [leadId], references: [id])
  clientOrgId    String?        // set at activation
  number         String         // human-facing, e.g. PROP-0001
  title          String
  status         ProposalStatus @default(DRAFT)
  currency       String         @default("USD")
  subtotalCents  Int            @default(0)
  totalCents     Int            @default(0)
  depositCents   Int            @default(0) // the activation payment amount
  depositPercent Int?                       // % used to compute it (default 33)
  notes          String?                    // scope summary / message to the client
  changeRequest  String?                    // last "request changes" note from the prospect
  // Secure-link access — only the SHA-256 hash of the token is stored (ClientInvitation pattern).
  tokenHash      String?        @unique
  expiresAt      DateTime?
  sentAt         DateTime?
  viewedAt       DateTime?
  acceptedAt     DateTime?
  declinedAt     DateTime?
  supersededById String?                    // the revision that replaced this one
  createdByStaffUserId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  lineItems ProposalLineItem[]
  contract  Contract?
  invoices  Invoice[]

  @@unique([tenantId, number])
  @@index([tenantId, leadId])
  @@index([tenantId, status])
  @@index([expiresAt])
  @@map("proposals")
}

model ProposalLineItem {
  id               String          @id @default(cuid())
  tenantId         String
  proposalId       String
  proposal         Proposal        @relation(fields: [proposalId], references: [id])
  servicePackageId String?
  servicePackage   ServicePackage? @relation(fields: [servicePackageId], references: [id])
  description      String
  quantity         Int             @default(1)
  unitCents        Int
  amountCents      Int
  sortOrder        Int             @default(0)
  createdAt        DateTime        @default(now())

  @@index([proposalId])
  @@map("proposal_line_items")
}

model Contract {
  id           String         @id @default(cuid())
  tenantId     String
  proposalId   String         @unique
  proposal     Proposal       @relation(fields: [proposalId], references: [id])
  leadId       String
  clientOrgId  String?
  number       String         // e.g. AGR-0001
  title        String
  bodyMarkdown String?        // the agreement text presented for signing
  contentHash  String?        // SHA-256 of the exact text shown (signing evidence)
  version      Int            @default(1)
  status       ContractStatus @default(DRAFT)
  provider     String         @default("inhouse") // 'inhouse' | 'docusign' | …
  sentAt       DateTime?
  signedAt     DateTime?
  createdByStaffUserId String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  signatures ContractSignature[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("contracts")
}

model ContractSignature {
  id                 String     @id @default(cuid())
  tenantId           String
  contractId         String
  contract           Contract   @relation(fields: [contractId], references: [id])
  signerType         SignerType @default(CLIENT)
  signerName         String
  signerEmail        String
  signerTitle        String?
  // Evidence — no raw IP (Canon privacy rule): salted hash + UA + the content hash signed.
  ipHash             String?
  userAgent          String?
  contentHash        String?
  provider           String     @default("inhouse")
  providerEnvelopeId String?
  signedAt           DateTime   @default(now())

  @@index([tenantId, contractId])
  @@map("contract_signatures")
}

// Per-tenant, per-kind atomic counter for human-facing document numbers (PROP-0001, AGR-0001…).
// Allocated via upsert+increment inside a transaction — the race-safe pattern used by RateLimitCounter.
model DocumentCounter {
  tenantId  String
  kind      String   // 'PROPOSAL' | 'CONTRACT' | 'INVOICE'
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([tenantId, kind])
  @@map("document_counters")
}

