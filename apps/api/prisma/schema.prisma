  UPLOADED       // object stored + existence/size verified
  SCANNING       // malware scan in progress
  AVAILABLE      // scan clean — the ONLY downloadable state
  QUARANTINED    // scan flagged malware — never downloadable
  REJECTED       // failed validation / storage verification
  DELETED        // soft-deleted
}

enum ScanResult {
  CLEAN
  INFECTED
  ERROR
  TIMEOUT
  UNSUPPORTED
  SKIPPED
}

// A malware-scan attempt for a file — durable job + result/evidence in one row.
// The worker (or an inline call for small/dev files) drives it; a file becomes
// AVAILABLE only when a scan records CLEAN. Retryable with backoff; DEAD after
// maxAttempts leaves the file unavailable (never silently available).
model FileScan {
  id             String      @id @default(cuid())
  tenantId       String
  fileId         String
  file           ProjectFile @relation(fields: [fileId], references: [id])

  // Durable-job lifecycle (JobStatus reused: PENDING/PROCESSING/SUCCEEDED/FAILED/DEAD)
  status         JobStatus   @default(PENDING)
  idempotencyKey String      @unique
  attempts       Int         @default(0)
  maxAttempts    Int         @default(5)
  nextAttemptAt  DateTime    @default(now())
  lastError      String?
  errorCode      String?
  retryCount     Int         @default(0)

  // Scan evidence (staff-only; never surfaced to clients)
  provider         String?
  engine           String?
  engineVersion    String?
  signatureVersion String?
  result           ScanResult?
  threatName       String?
  startedAt        DateTime?
  completedAt      DateTime?
  fileHash         String?
  fileSizeBytes    Int?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status, nextAttemptAt])
  @@index([fileId])
  @@map("file_scans")
}

