{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "worker": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "db:studio": "prisma studio",
    "test:db:prepare": "node scripts/test-db.mjs prepare",
    "test:db:reset": "node scripts/test-db.mjs reset",
    "pretest": "node scripts/test-db.mjs prepare",
    "test": "node scripts/run-tests.mjs all",
    "test:unit": "node scripts/run-tests.mjs unit",
    "pretest:integration": "node scripts/test-db.mjs prepare",
    "test:integration": "node scripts/run-tests.mjs integration",
    "pretest:e2e": "node scripts/test-db.mjs prepare",
    "test:e2e": "node scripts/run-tests.mjs e2e"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "postmark": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "20.14.11",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "typescript": "5.4.5"
  }
}
