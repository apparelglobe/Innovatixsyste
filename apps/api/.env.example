# ── Innovatix API (lead pipeline) ────────────────────────────────────────────
NODE_ENV=development
PORT=4040

# Database — MUST match docker-compose.yml (or the local brew Postgres).
# Docker Compose uses port 5432. If you run local Postgres WITHOUT Docker
# (scripts/dev-db.sh), it uses port 5544 to avoid clashing with any system Postgres.
DATABASE_URL=postgresql://innovatix:innovatix_dev_pw@localhost:5432/innovatix?schema=public

# Tenant resolution (single-tenant for the public site; multi-tenant-ready).
INNOVATIX_DEFAULT_TENANT_SLUG=innovatix-systems

# CORS — comma-separated approved origins for the public lead endpoint.
LEADS_ALLOWED_ORIGINS=http://localhost:4030,https://innovatixsystems.com,https://www.innovatixsystems.com

# Rate limiting (per hashed identifier).
LEADS_RATE_LIMIT_MAX=5
LEADS_RATE_LIMIT_WINDOW_MS=600000

# Abuse-identifier hashing (salt for hashed IP; NEVER log raw IPs).
ABUSE_HASH_SALT=change-me-in-prod

# Email transport: 'outbox' (dev, DB-backed viewer) | 'postmark' (prod)
EMAIL_TRANSPORT=outbox
EMAIL_FROM="Innovatix Systems <hello@innovatixsystems.com>"
EMAIL_INTERNAL_TO=sales@innovatixsystems.com
# Postmark (prod only)
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound

# Dev outbox viewer (/v1/dev/outbox) — auto-disabled when NODE_ENV=production.
DEV_OUTBOX_VIEWER=true

# SLA (business-hours-aware); target minutes for first response.
LEADS_SLA_TARGET_MINUTES=240
LEADS_SLA_TIMEZONE=America/New_York

# Cal.com booking + webhook signature secret.
CALCOM_WEBHOOK_SECRET=
CALCOM_EVENT_URL=https://cal.com/innovatix/consultation

# Side-effect worker.
OUTBOX_POLL_MS=2000
OUTBOX_MAX_ATTEMPTS=6

# ── Client portal + staff console (Launch 2/3) ───────────────────────────────
# Origins allowed to call the portal API with credentials (comma-separated).
PORTAL_WEB_ORIGIN=http://localhost:3001

# File storage: 'local' (dev, writes under STORAGE_LOCAL_DIR) | 's3' (prod).
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.filestore
MAX_FILE_BYTES=26214400
# Required only when STORAGE_PROVIDER=s3 (enforced in production):
S3_BUCKET=
S3_REGION=

# Payments: 'stub' (dev, no external keys) | 'stripe' (prod).
PAYMENTS_PROVIDER=stub
# Required only when PAYMENTS_PROVIDER=stripe (enforced in production):
STRIPE_SECRET_KEY=

# ── SECRETS — SEE docs/DEPLOYMENT.md ─────────────────────────────────────────
# The values below are SAFE DEVELOPMENT DEFAULTS. In production the API REFUSES
# TO START (config.ts → validateProductionSecrets) unless every secret is:
#   • present and non-empty
#   • NOT one of the dev placeholders below
#   • at least 32 characters
#   • PORTAL_JWT_SECRET and STAFF_JWT_SECRET are DIFFERENT values
# Generate strong values, e.g.:  openssl rand -base64 48
#
# Client-portal JWT signing secret (cookie: inx_portal).
PORTAL_JWT_SECRET=dev-portal-secret-change-me
# Staff/admin JWT signing secret (cookie: inx_staff). MUST differ from the above.
STAFF_JWT_SECRET=dev-staff-secret-change-me
# (ABUSE_HASH_SALT, CALCOM_WEBHOOK_SECRET, PAYMENTS_WEBHOOK_SECRET are set above
#  and are ALSO required + strength-checked in production.)
PAYMENTS_WEBHOOK_SECRET=dev-payments-webhook-secret

# Bearer token required to read GET /metrics. REQUIRED in production when metrics are enabled.
METRICS_TOKEN=
