# ─────────────────────────────────────────────────────────────────────────────
# Innovatix API — PRODUCTION environment template.
#
# Copy to your secrets manager / deploy target as the API's env. Every REPLACE_ME
# value below is a strong-LOOKING but NON-FUNCTIONAL placeholder — replace ALL of
# them with real, unique, randomly-generated secrets before go-live. Generate
# secrets with:  openssl rand -base64 48
#
# Validate a filled-in copy from a clean shell WITHOUT booting the app:
#   scripts/verify-prod-config.sh apps/api/.env.production
# (imports src/config with NODE_ENV=production → runs the exact boot-time guard.)
#
# The API refuses to boot in production if any required/secret var here is
# missing, weak (<32 chars), a known dev default, or a provider key is absent for
# the selected provider. See docs/DEPLOYMENT.md + docs/STAGING.md for the matrix.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=4040

# ── Database ─────────────────────────────────────────────────────────────────
# Point at the PROD Postgres (managed, PITR on). Separate DB + creds from staging.
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/innovatix?schema=public

# ── Tenancy / CORS / origins ─────────────────────────────────────────────────
INNOVATIX_DEFAULT_TENANT_SLUG=innovatix-systems
LEADS_ALLOWED_ORIGINS=https://www.innovatixsystems.com
PORTAL_WEB_ORIGIN=https://portal.innovatixsystems.com

# ── Secrets (MUST be unique, random, ≥32 chars; PORTAL≠STAFF) ─────────────────
PORTAL_JWT_SECRET=REPLACE_ME_portal_jwt_secret_min_32_chars_0001
STAFF_JWT_SECRET=REPLACE_ME_staff_jwt_secret_min_32_chars_0002
ABUSE_HASH_SALT=REPLACE_ME_abuse_hash_salt_min_32_chars_00003
CALCOM_WEBHOOK_SECRET=REPLACE_ME_calcom_webhook_secret_32_chars_004
PAYMENTS_WEBHOOK_SECRET=REPLACE_ME_payments_webhook_secret_32_chars_5

# ── Anti-abuse / SLA ─────────────────────────────────────────────────────────
LEADS_RATE_LIMIT_MAX=5
LEADS_RATE_LIMIT_WINDOW_MS=600000
LEADS_SLA_TARGET_MINUTES=240
LEADS_SLA_TIMEZONE=America/New_York

# ── Email (Postmark live stream in prod) ─────────────────────────────────────
EMAIL_TRANSPORT=postmark
EMAIL_FROM=Innovatix Systems <hello@innovatixsystems.com>
EMAIL_INTERNAL_TO=sales@innovatixsystems.com
POSTMARK_SERVER_TOKEN=REPLACE_ME_postmark_server_token
POSTMARK_MESSAGE_STREAM=outbound
# The dev outbox viewer is force-disabled in production regardless of this flag.
DEV_OUTBOX_VIEWER=false

# ── Booking (Cal.com live event) ─────────────────────────────────────────────
CALCOM_EVENT_URL=https://cal.com/innovatix/consultation

# ── Object storage (S3-compatible; separate prod bucket, least-privilege keys) ─
STORAGE_PROVIDER=s3
S3_BUCKET=innovatix-prod
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=REPLACE_ME_s3_access_key_id
S3_SECRET_ACCESS_KEY=REPLACE_ME_s3_secret_access_key
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_TTL_SECONDS=300
MAX_FILE_BYTES=26214400
STORAGE_ALLOW_ARCHIVES=false

# ── Malware scanning (real ClamAV daemon; boot fails if unreachable in prod) ──
MALWARE_SCANNER_PROVIDER=clamav
CLAMAV_HOST=clamav.internal
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
CLAMAV_MAX_FILE_BYTES=104857600
CLAMAV_REQUIRED_IN_PRODUCTION=true
SCAN_INLINE_MAX_BYTES=6291456

# ── Payments (Stripe live; webhook-authoritative) ────────────────────────────
PAYMENTS_PROVIDER=stripe
STRIPE_SECRET_KEY=REPLACE_ME_stripe_live_secret_key_sk_live_xxx
STRIPE_WEBHOOK_SECRET=REPLACE_ME_stripe_webhook_secret_whsec_live_x

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=REPLACE_ME_prod_sentry_dsn_or_leave_blank
ALERT_WEBHOOK_URL=REPLACE_ME_prod_alert_webhook_or_leave_blank
METRICS_ENABLED=true
# Required in production when METRICS_ENABLED=true — gates GET /metrics.
METRICS_TOKEN=REPLACE_ME_metrics_bearer_token_min_32_chars_006
AUTH_FAIL_ALERT_THRESHOLD=25
AUTH_FAIL_ALERT_WINDOW_MS=60000

# ── Worker / invitations ─────────────────────────────────────────────────────
OUTBOX_POLL_MS=2000
OUTBOX_MAX_ATTEMPTS=6
PORTAL_INVITE_TTL_HOURS=168
